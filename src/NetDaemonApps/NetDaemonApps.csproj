<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>NetDaemonApps</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </None>
        <None Update="appsettings.Development.json">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
          <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <None Include="apps\**\*.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests\**" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="NetDaemon.AppModel" />
        <PackageReference Include="NetDaemon.Extensions.Mqtt" />
        <PackageReference Include="NetDaemon.Extensions.Tts" />
        <PackageReference Include="NetDaemon.Runtime" />
        <PackageReference Include="NetDaemon.HassModel" />
        <PackageReference Include="NetDaemon.Client" />
        <PackageReference Include="NetDaemon.Extensions.Scheduling" />
        <PackageReference Include="NetDaemon.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>


</Project>
